    <cac:ProcessJustification>
      <cbc:ProcessReasonCode languageID="SLV" listName="direct-award-justification">rd</cbc:ProcessReasonCode>
      <cbc:ProcessReason languageID="SLV">Naročnik bo za izvedbo raziskovalno-razvojne in inovacijske aktivnosti na podlagi 1. točke tretjega odstavka 22. člena Zakona o javnem naročanju na področju obrambe in varnosti izvedel javno naročilo po postopku s pogajanji brez predhodne objave. K oddaji ponudbe je naročnik na podlagi prijave na Javni poziv zainteresiranim subjektov za sodelovanje pri izvajanju razvojno-raziskovalnih in inovacijskih projektov z namenom povečanja tehničnih/tehnoloških zmogljivosti obrambnega sistema Republike Slovenije, povabil najbolj primernega nosilca RRI aktivnosti z namenom oblikovanja konzorcija, in sicer podjetje: TECES, grozd zelenih tehnologij, Maribor, Pobreška cesta 20, 2000 Maribor. Po izvedenem postopku bo z izbranim izvajalcem sklenjena pogodba za izvedbo RRI aktivnosti ALENOS 2.</cbc:ProcessReason>
    </cac:ProcessJustification>
  </cac:TenderingProcess>
