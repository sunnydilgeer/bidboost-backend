    <cbc:Name languageID="SLV">Zagotavljanje okoljsko manj obremenjujočih storitev tiskanja</cbc:Name>
    <cbc:Description languageID="SLV">Predmet javnega naročila je zagotavljanje storitev tiskanja na način: 
