		<cac:TenderingTerms>
			<ext:UBLExtensions>
				<ext:UBLExtension>
					<ext:ExtensionContent>
						<efext:EformsExtension>
							<efac:SelectionCriteria>
								<cbc:TendererRequirementTypeCode listName="selection-criterion">slc-stand-ins</cbc:TendererRequirementTypeCode>
								<cbc:Description languageID="DEU">§45 (4) Nr. 2 VGV:  Nachweis, dass im Auftragsfall durch eine Haftpflichtversicherung eine Deckungssumme für Personenschäden in Höhe von 1,5 Mio. EUR und für sonstige Schäden (Sach- und Vermögensschäden) in Höhe von 0,5 Mio. EUR gegeben ist.</cbc:Description>
							</efac:SelectionCriteria>
							<efac:SelectionCriteria>
								<cbc:TendererRequirementTypeCode listName="selection-criterion">slc-abil-ref-work</cbc:TendererRequirementTypeCode>
								<cbc:Description languageID="DEU">§46 (3) Nr.1 VGV Ausführung von Leistungen in den letzten drei Jahren, die mit der zu vergebenden Leistung vergleichbar sind.  Der Bewerber muss mindestens folgende Leistungen erbracht haben:   Konzeption/ Überplanung der Radwegweisung eines interkommunalen oder großräumigeren Netzes. Es werden auch Leistungen berücksichtigt, die bis zu 10 Jahre zurückliegen.</cbc:Description>
							</efac:SelectionCriteria>
							<efac:SelectionCriteria>
								<cbc:TendererRequirementTypeCode listName="selection-criterion">slc-abil-staff-qual</cbc:TendererRequirementTypeCode>
								<cbc:Description languageID="DEU">§46 (3) Nr.2 VGV Leistungsfähigkeit der technischen Fachkräfte, die im Zusammenhang mit der Leistungserbringung eingesetzt werden sollen, inkl. berufliche Befähigung.  Der Bewerber muss mindestens folgende Befähigung aufweisen:   -mind. 1 technische(r) Mitarbeiter(in) mit Berufsausbildung (z.B. CAD-Zeichner), Bachelorabschluss / höherwertiger Abschluss; mind. 3 Jahren Berufserfahrung -mind. 1 Ingenieur mit Fachrichtung Verkehrswesen oder vergleichbarer Abschluss; Dipl.-Ing. (FH / TU), Master / höherwertiger Abschluss; mind. 5 Jahre Berufserfahrung</cbc:Description>
							</efac:SelectionCriteria>
							<efac:SelectionCriteria>
								<cbc:TendererRequirementTypeCode listName="selection-criterion">slc-abil-staff-qual</cbc:TendererRequirementTypeCode>
								<cbc:Description languageID="DEU">§46 (3) Nr.6 VGV Leistungsfähigkeit der Führungskräfte des Unternehmens, die die technische Leitung innehaben inkl. berufliche Befähigung. Der Bieter muss mindestens folgende Befähigung aufweisen:  Dipl.-Ing (FH / TU) / Master Verkehrswesen oder vergleichbarer Abschluss; mind. 5 Jahre Berufserfahrung; Die Führungskraft kann auch gleichzeitig einer der geforderten Fachkräfte entsprechen</cbc:Description>
							</efac:SelectionCriteria>
							<efac:SelectionCriteria>
								<cbc:TendererRequirementTypeCode listName="selection-criterion">slc-abil-mgmt-qual</cbc:TendererRequirementTypeCode>
								<cbc:Description languageID="DEU">§46 (3) Nr.3 VGV Maßnahmen des Bieters, zur Gewährleistung der Qualität und seiner Untersuchungsmöglichkeiten.  Der Bieter hat seine Maßnahmen zur Qualitätssicherung zu beschreiben.</cbc:Description>
							</efac:SelectionCriteria>
							<efac:SelectionCriteria>
								<cbc:TendererRequirementTypeCode listName="selection-criterion">slc-abil-facil-tools</cbc:TendererRequirementTypeCode>
								<cbc:Description languageID="DEU">§46 (3) Nr.9 VGV Ausstattung, Geräte und technische Ausrüstung, über die das Unternehmen für die Ausführung des Auftrags verfügt.</cbc:Description>
							</efac:SelectionCriteria>
							<efac:SelectionCriteria>
								<cbc:TendererRequirementTypeCode listName="selection-criterion">slc-abil-subc</cbc:TendererRequirementTypeCode>
								<cbc:Description languageID="DEU">§46 (3) Nr.10 VGV Teil des Auftrages, der unter Umständen an Unterauftragnehmer vom Bieter vergeben werden sollen.  Der Bieter ist nur dann geeignet, wenn die von ihm benannten Unterauftragnehmer den Mindeststandards für die übernommenen Leistungen genügen.</cbc:Description>
							</efac:SelectionCriteria>
							<efac:StrategicProcurement>
								<efbc:ApplicableLegalBasis listName="cvd-scope">false</efbc:ApplicableLegalBasis>
