               <efac:ContractModification>
                  <efbc:ChangedNoticeIdentifier>f92ec725-fa6e-4365-8daa-efca56fc848d-01</efbc:ChangedNoticeIdentifier>
                  <efbc:ModifiedContractIdentifier>CON-0001</efbc:ModifiedContractIdentifier>
                  <efac:Change>
                     <efbc:ChangeDescription languageID="SLK"><![CDATA[Predmetom Dodatku č. 3 je navýšenie zmluvnej ceny o 9 232 800,00 EUR bez DPH na výslednú zmluvnú cenu 52 454 435,60 EUR bez DPH.]]></efbc:ChangeDescription>
                     <efac:ChangedSection>
                        <efbc:ChangedSectionIdentifier>RESULT</efbc:ChangedSectionIdentifier>
                     </efac:ChangedSection>
                  </efac:Change>
                  <efac:ChangeReason>
                     <cbc:ReasonCode listName="modification-justification">mod-cir</cbc:ReasonCode>
                     <efbc:ReasonDescription languageID="SLK"><![CDATA[Dôvodom uzatvorenia dodatku je kumulatívny vplyv dvoch zásadných okolností, ktoré verejný obstarávateľ nemohol pri vynaložení náležitej starostlivosti v čase prípravy a vyhlásenia verejného obstarávania predvídať. Prvou je legislatívna zmena implementujúca smernicu EÚ, ktorá zavedením poplatku za emisie CO2 spôsobí nárast objemu vybraného mýta. Druhou okolnosťou je podstatne nižšia miera využívania Európskej služby elektronického výberu mýta (EETS) v porovnaní s      pôvodnými odhadmi. Kombinovaný účinok týchto faktorov má za následok, že pôvodne obstaraný počet palubných jednotiek (OBU) sa ukázal ako nedostatočný na zabezpečenie zákonných povinností správcu výberu mýta, predovšetkým na zabezpečenie výberu mýta vo vzťahu ku všetkým užívateľom vymedzených úsekov ciest. Vzhľadom na nemožnosť zmeny dodávateľa z technických a    ekonomických dôvodov je dodatok nevyhnutný na zabezpečenie kontinuity poskytovania mýtnych služieb.]]></efbc:ReasonDescription>
                  </efac:ChangeReason>
               </efac:ContractModification>
